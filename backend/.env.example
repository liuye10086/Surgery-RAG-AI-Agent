# 复制本文件为 .env，并填入真实值
# ── 数据库 ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/surgery_rag
# ── JWT ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# ── LLM ──────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# ── 文件上传 ─────────────────────────────────────────
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=50
# ── 分块 ─────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=50
CASE_CHUNK_MAX_SIZE=1500
# ── Embedding ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
# Hugging Face 镜像，例如 https://hf-mirror.com；留空则走官方
HF_ENDPOINT=
# ── OCR ──────────────────────────────────────────────
PDF_OCR_MIN_TEXT_LENGTH=50
PDF_OCR_DPI=150
PADDLEOCR_LANG=ch
PADDLEOCR_USE_GPU=False
# ── 检索 ─────────────────────────────────────────────
RETRIEVER_TOP_K_VECTOR=10
RETRIEVER_TOP_K_FULLTEXT=10
RETRIEVER_FUSION_K=60
RETRIEVER_FINAL_TOP_K=5
RETRIEVER_SIMILARITY_THRESHOLD=0.62
RETRIEVER_DUAL_MATCH_MARGIN=0.08
RETRIEVER_FULLTEXT_THRESHOLD=0.12
CHAT_MEMORY_ROUNDS=6
# ── 查询改写 ─────────────────────────────────────────
ENABLE_LLM_QUERY_REWRITE=True
REWRITE_MAX_HISTORY=6
REWRITE_MODEL=deepseek-chat
# ── PGVector ─────────────────────────────────────────
VECTOR_COLLECTION_NAME=surgery_docs
# 留空则复用 DATABASE_URL
VECTOR_STORE_CONNECTION_STRING=
# ── LangSmith 链路追踪（默认关闭）─────────────────────
LANGCHAIN_TRACING_V2=False
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=surgery-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# ── Agent 模式（预留，默认关闭）────────────────────────
ENABLE_AGENT_MODE=False
AGENT_MAX_ITERATIONS=5
