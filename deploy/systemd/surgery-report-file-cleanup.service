[Unit]
Description=Surgery durable PDF deletion cleanup
After=network.target postgresql.service

[Service]
Type=oneshot
User=surgery
Group=surgery
WorkingDirectory=/opt/surgery-rag/
EnvironmentFile=/opt/surgery-rag/backend/.env
ExecStart=/opt/surgery-rag/backend/venv/bin/python scripts/manage_report_pdf_archives.py cleanup --once
TimeoutStopSec=15
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
